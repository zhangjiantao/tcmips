#ifndef TCMIPS_DEVKIT_CONFIG_H
#define TCMIPS_DEVKIT_CONFIG_H

#define TCMIPS_VERSION_MAJOR @TCMIPS_VERSION_MAJOR@
#define TCMIPS_VERSION_MINOR @TCMIPS_VERSION_MINOR@
#define TCMIPS_VERSION_PATCH @TCMIPS_VERSION_PATCH@
#define TCMIPS_VERSION_STRING "@TCMIPS_VERSION_STRING@"

/*
 * Build Config
 */

#cmakedefine TCM_CONSOLE_ASCII_FONT
#cmakedefine TCM_CONSOLE_UNICODE_FONT

/*
 * Debug build flags for the SDK-provided compatibility libraries.
 */
#cmakedefine TCM_SDL_DEBUG
#cmakedefine TCM_MEMFS_DEBUG

/*
 * Limits
 */
#define TCM_SCREEN_MAX_W 1024
#define TCM_SCREEN_MAX_H 768

/*
 * Memory layout
 */
#define TCM_MEMORY_SIZE          @TCM_MEMORY_SIZE@

#define TCM_STACK_SIZE           @TCM_STACK_SIZE@
#define TCM_GUARD_PAGE_SIZE      @TCM_GUARD_PAGE_SIZE@
#define TCM_VRAM_ASCII_SIZE      @TCM_VRAM_ASCII_SIZE@
#define TCM_VRAM_PIXEL_SIZE      @TCM_VRAM_PIXEL_SIZE@

#define TCM_HEAP_LIMIT_ADDR      @TCM_HEAP_LIMIT_ADDR@
#define TCM_GUARD_PAGE_ADDR      @TCM_GUARD_PAGE_ADDR@
#define TCM_STACK_LIMIT_ADDR     @TCM_STACK_LIMIT_ADDR@
#define TCM_STACK_TOP_ADDR       @TCM_STACK_TOP_ADDR@
#define TCM_VRAM_ASCII_ADDR      @TCM_VRAM_ASCII_ADDR@
#define TCM_VRAM_PIXEL_ADDR      @TCM_VRAM_PIXEL_ADDR@


/*
 * Revision
 */
#define TCM_REVISION "@TCM_REVISION@"

#define TCM_REPOSITORY "@TCM_REPOSITORY@"

#define TCM_AUTHOR "@TCM_AUTHOR@"

#endif // TCMIPS_DEVKIT_CONFIG_H
